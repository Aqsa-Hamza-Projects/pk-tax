{
  "name": "pk-tax",
  "version": "0.0.1",
  "description": "Pakistan income tax calculator for salaried individuals — versioned FBR tax-year rules (2025-26, 2026-27), progressive slabs, surcharge, monthly/annual tax, net salary, effective and marginal rates. Zero-dependency TypeScript engine for payroll, HR and fintech apps.",
  "keywords": [
    "pakistan",
    "pakistani",
    "tax",
    "income-tax",
    "salary-tax",
    "tax-calculator",
    "salary-calculator",
    "payroll",
    "fbr",
    "tax-slabs",
    "withholding-tax",
    "net-salary",
    "take-home-pay",
    "finance-act",
    "hr",
    "fintech",
    "pk",
    "pkr",
    "typescript"
  ],
  "author": "Aqsa LogicByte",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "examples": "npm run build && tsx examples/01-salary-tax.ts && tsx examples/02-monthly-salary.ts && tsx examples/03-inspect-rules.ts && tsx examples/04-error-handling.ts && node examples/05-commonjs.cjs && node examples/06-esm.mjs",
    "hooks:install": "husky",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test && npm run examples"
  },
  "lint-staged": {
    "*.{ts,cts,mts,js,cjs,mjs}": [
      "prettier --check",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aqsa-Hamza-Projects/pk-tax.git"
  },
  "homepage": "https://github.com/Aqsa-Hamza-Projects/pk-tax#readme",
  "bugs": {
    "url": "https://github.com/Aqsa-Hamza-Projects/pk-tax/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
